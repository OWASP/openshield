---
import Base from '../layouts/Base.astro';
import { url } from '../lib/base';
---

<Base title="Page not found · OpenShield" description="This page does not exist.">
  <div class="wrap">
    <div class="notfound">
      <div class="code">4<span>0</span>4</div>
      <p>This check did not pass. The page you are looking for does not exist.</p>
      <a class="btn btn-dark" href={url('/')}>Back to the start <span class="ar">&#8594;</span></a>
    </div>
  </div>
</Base>
