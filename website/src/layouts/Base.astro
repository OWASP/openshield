---
import { url } from '../lib/base';
import { repoData } from '../lib/repoData';
import logoLight from '../assets/logo-light.png';
import logoDark from '../assets/logo-dark.png';

import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/dm-mono/300.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** which nav tab is active: start | rules | docs | blog | roadmap | community */
  active?: string;
  /** page-level structured data (SoftwareApplication, BlogPosting, ...) */
  jsonLd?: Record<string, unknown>;
}
const {
  title = 'OpenShield · Open source security posture for Azure',
  description = 'OpenShield scans an Azure subscription for misconfigurations, maps every finding to CIS, NIST, ISO 27001 and SOC 2, and ships a remediation playbook per rule. MIT licensed, free forever.',
  active = 'start',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const GITHUB = 'https://github.com/openshield-org/openshield';
const year = new Date().getFullYear();

/* Structured data: Organization + WebSite on every page. Read by search
   engines only; renders nothing visible. */
const siteRoot = new URL(url('/'), Astro.site).href;
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'OpenShield',
      url: siteRoot,
      logo: new URL(url('/favicon.svg'), Astro.site).href,
      sameAs: [GITHUB],
    },
    {
      '@type': 'WebSite',
      name: 'OpenShield',
      url: siteRoot,
    },
  ],
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="OpenShield Blog" href={url('/rss.xml')}>

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="OpenShield">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>

<!-- Structured data (search engines only, nothing rendered) -->
<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} is:inline></script>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>}

<!--
  Content-Security-Policy ported from the retired vercel.json. Everything is
  self-hosted by the Astro build; connect-src only needs the GitHub API
  (star count).
-->
<meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'`}>
<meta http-equiv="X-Content-Type-Options" content="nosniff">
<meta name="referrer" content="strict-origin-when-cross-origin">
</head>
<body>

<nav class="nav">
  <div class="wrap">
    <a class="wordmark" href={url('/')}><img src={logoLight.src} alt="OpenShield" width="132" height="22"></a>
    <div class="navlinks">
      <a href={url('/#start')} aria-current={active === 'start' ? 'page' : undefined}>Start here</a>
      <a href={url('/rules/')} aria-current={active === 'rules' ? 'page' : undefined}>Rules</a>
      <a href={url('/docs/')} aria-current={active === 'docs' ? 'page' : undefined}>Docs</a>
      <a href={url('/blog/')} aria-current={active === 'blog' ? 'page' : undefined}>Blog</a>
      <a href={url('/#roadmap')} aria-current={active === 'roadmap' ? 'page' : undefined}>Roadmap</a>
      <a href={url('/community/')} aria-current={active === 'community' ? 'page' : undefined}>Community</a>
    </div>
    <div class="nav-right">
      <a class="star-btn" href={GITHUB} target="_blank" rel="noopener">&#9733; Star<span id="starCount"></span></a>
    </div>
  </div>
</nav>

<slot />

<section class="cta" id="get-started">
  <div class="wrap">
    <div class="kicker">Get started</div>
    <h2>Open source security posture for Azure.</h2>
    <div class="hero-cta">
      <a class="btn btn-accent" href={url('/docs/')}>Read the quickstart <span class="ar">&#8594;</span></a>
      <a class="btn btn-ghostline" href={GITHUB} target="_blank" rel="noopener">Star on GitHub</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="f-grid">
      <div>
        <img class="f-logo" src={logoDark.src} alt="OpenShield" width="156" height="26">
        <p class="f-tag">Detect Azure misconfigurations, map them to compliance frameworks, and remediate with the exact CLI command. Community-driven, MIT licensed.</p>
      </div>
      <div class="f-col">
        <h4>Product</h4>
        <a href={url('/rules/')}>Rule book</a>
        <a href="https://openshield-gules.vercel.app" target="_blank" rel="noopener">Dashboard</a>
        <a href={`${GITHUB}/tree/dev/playbooks/cli`} target="_blank" rel="noopener">Playbooks</a>
        <a href={url('/#roadmap')}>Roadmap</a>
      </div>
      <div class="f-col">
        <h4>Resources</h4>
        <a href={url('/docs/')}>Documentation</a>
        <a href={url('/blog/')}>Blog</a>
        <a href={url('/rss.xml')}>RSS feed</a>
        <a href={`${GITHUB}/releases`} target="_blank" rel="noopener">Releases</a>
      </div>
      <div class="f-col">
        <h4>Stay in the loop</h4>
        <div class="sub sub-links">
          <a href={url('/rss.xml')}>RSS feed</a>
          <a href={`${GITHUB}/subscription`} target="_blank" rel="noopener">Watch releases</a>
        </div>
        <p class="sub-status mono">New posts land in the feed. GitHub notifies you on every release.</p>
        <div style="margin-top:14px">
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <a href={`${GITHUB}/issues`} target="_blank" rel="noopener">Issues</a>
          <a href={`${GITHUB}/blob/dev/CONTRIBUTING.md`} target="_blank" rel="noopener">Contributing</a>
        </div>
      </div>
    </div>
    <div class="f-bottom">
      <span>&copy; {year} OPENSHIELD CONTRIBUTORS / MIT LICENCE / {repoData.contributorCount} CONTRIBUTORS</span>
      <span>PROJECT LEAD: VISHNU / MAINTAINERS: RITIK / TANVIR / PARTH</span>
    </div>
  </div>
</footer>

<script>
  /* star count + nav elevation, shared by every page */
  const nav = document.querySelector('.nav');
  const onScroll = () => nav && nav.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  fetch('https://api.github.com/repos/openshield-org/openshield')
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      const el = document.getElementById('starCount');
      if (el && d && typeof d.stargazers_count === 'number') {
        el.textContent = ` ${d.stargazers_count.toLocaleString('en-US')}`;
      }
    })
    .catch(() => {});
</script>

</body>
</html>
